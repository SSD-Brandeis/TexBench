{
  "$schema": "../workload_schema.json",
  "sections": [
    {
      "groups": [
        {
          "name": "Interleaved Multi-distributional",
          "enable_granular_stats": true,
          "inserts": {
            "op_count": 500000,
            "key": {
              "uniform": {
                "len": 20
              }
            },
            "val": {
              "uniform": {
                "len": 256
              }
            }
          },
          "point_queries": {
            "op_count": 200000,
            "selection": {
              "latest": {
                "s": 0.99,
                "n": 500000
              }
            }
          },
          "empty_point_queries": {
            "op_count": 100000,
            "key": {
              "uniform": {
                "len": 20
              }
            }
          },
          "point_deletes": {
            "op_count": 100000,
            "selection": {
              "uniform": {
                "min": 0,
                "max": 1
              }
            }
          },
          "range_deletes": {
            "op_count": 100000,
            "selection": {
              "pareto": {
                "scale": 1,
                "shape": 2
              }
            },
            "selectivity": 0.0001,
            "range_format": "StartEnd"
          }
        }
      ]
    }
  ]
}
